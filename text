5.crc-12 and crc-16

#include <stdio.h>
#include <string.h>

int main() {
    char data[100], divisor[20], encoded[120], received[120];
    int dataLen, divLen, totalLen;

    printf("Enter data bits: ");
    scanf("%s", data);
    printf("Enter divisor bits: ");
    scanf("%s", divisor);

    dataLen = strlen(data);
    divLen = strlen(divisor);
    totalLen = dataLen + divLen - 1;

    // Step 1: Append zeros
    for (int i = 0; i < dataLen; i++)
        encoded[i] = data[i];
    for (int i = dataLen; i < totalLen; i++)
        encoded[i] = '0';
    encoded[totalLen] = '\0';

    // Step 2: Division
    char remainder[20];
    for (int i = 0; i < divLen; i++)
        remainder[i] = encoded[i];

    for (int i = 0; i < dataLen; i++) {
        if (remainder[0] == '1') {
            for (int j = 1; j < divLen; j++)
                remainder[j] = (remainder[j] == divisor[j]) ? '0' : '1';
        }
        for (int j = 0; j < divLen - 1; j++)
            remainder[j] = remainder[j + 1];
        remainder[divLen - 1] = encoded[i + divLen];
    }

    // Step 3: Append remainder to data
    for (int i = 0; i < divLen - 1; i++)
        encoded[dataLen + i] = remainder[i];
    encoded[totalLen] = '\0';

    printf("Encoded data to transmit: %s\n", encoded);

    // Step 4: Receiver side check
    printf("Enter received data bits: ");
    scanf("%s", received);

    // Repeat division at receiver
    for (int i = 0; i < divLen; i++)
        remainder[i] = received[i];

    for (int i = 0; i < strlen(received) - divLen + 1; i++) {
        if (remainder[0] == '1') {
            for (int j = 1; j < divLen; j++)
                remainder[j] = (remainder[j] == divisor[j]) ? '0' : '1';
        }
        for (int j = 0; j < divLen - 1; j++)
            remainder[j] = remainder[j + 1];
        remainder[divLen - 1] = received[i + divLen];
    }

    int error = 0;
    for (int i = 0; i < divLen - 1; i++)
        if (remainder[i] == '1') error = 1;

    if (error == 0)
        printf("Data transmitted correctly!\n");
    else
        printf("Error detected in transmission!\n");

    return 0;
}



1. Dijkstra’s Algorithm  

#include <stdio.h>
#define INF 9999
#define MAX 10

void printPath(int parent[], int j) {
    if (parent[j] == -1) {
        printf("%d", j);
        return;
    }
    printPath(parent, parent[j]);
    printf(" -> %d", j);
}

int main() {
    int graph[MAX][MAX], dist[MAX], visited[MAX], parent[MAX];
    int n, i, j, u, min, start;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter starting node (0 to %d): ", n - 1);
    scanf("%d", &start);

    for (i = 0; i < n; i++) {
        dist[i] = INF;
        visited[i] = 0;
        parent[i] = -1;
    }
    dist[start] = 0;

    for (i = 0; i < n - 1; i++) {
        min = INF;
        u = -1;

        for (j = 0; j < n; j++)
            if (!visited[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }

        if (u == -1)
            break;

        visited[u] = 1;

        for (j = 0; j < n; j++) {
            if (graph[u][j] && !visited[j] && dist[u] + graph[u][j] < dist[j]) {
                dist[j] = dist[u] + graph[u][j];
                parent[j] = u;
            }
        }
    }

    printf("Shortest distances and paths from node %d:\n", start);
    for (i = 0; i < n; i++) {
        if (dist[i] == INF)
            printf("To node %d: No path\n", i);
        else {
            printf("To node %d: %d, Path: ", i, dist[i]);
            printPath(parent, i);
            printf("\n");
        }
    }
    return 0;
}


