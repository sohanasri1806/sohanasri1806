3. Leaky Bucket algo

#include <stdio.h>

int main() {
    int bucketSize, outputRate, n;
    int packetSize, remaining = 0;
    int totalPackets = 0, totalSent = 0, totalDropped = 0;

    printf("Enter bucket size (in bytes): ");
    scanf("%d", &bucketSize);

    printf("Enter output rate (bytes per unit time): ");
    scanf("%d", &outputRate);

    printf("Enter number of packets: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        printf("\nEnter size of packet %d: ", i);
        scanf("%d", &packetSize);

        printf("Packet %d incoming: %d bytes\n", i, packetSize);
        totalPackets++;

        if (packetSize > bucketSize) {
            printf("=> Packet dropped! (Exceeds bucket capacity)\n");
            totalDropped++;
            continue;
        }

        remaining += packetSize;

        if (remaining > bucketSize) {
            printf("=> Bucket overflow! Packet dropped!\n");
            remaining -= packetSize;
            totalDropped++;
        } else {
            while (remaining > outputRate) {
                printf("=> Sent %d bytes\n", outputRate);
                totalSent += outputRate;
                remaining -= outputRate;
            }

            if (remaining > 0) {
                printf("=> Sent remaining %d bytes\n", remaining);
                totalSent += remaining;
                remaining = 0;
            }
        }
    }

    printf("\n=== Simulation Complete ===\n");
    printf("Total Packets Received: %d\n", totalPackets);
    printf("Total Bytes Sent: %d\n", totalSent);
    printf("Total Packets Dropped: %d\n", totalDropped);

    return 0;
}


