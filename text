4.subnets 

#include <stdio.h>
#define INF 9999
#define MAX 20

int main() {
    int n, cost[MAX][MAX], visited[MAX], mst[MAX][MAX];
    int i, j, u, v, edges = 0, min, total = 0, start;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
            if (cost[i][j] == 0) cost[i][j] = INF; // no edge
            mst[i][j] = 0; // initialize MST matrix
        }

    // choose starting vertex
    printf("Enter starting vertex (0 to %d): ", n-1);
    scanf("%d", &start);

    for (i = 0; i < n; i++) visited[i] = 0;
    visited[start] = 1;

    while (edges < n - 1) {
        min = INF;
        u = v = -1;

        for (i = 0; i < n; i++) {
            if (visited[i]) {
                for (j = 0; j < n; j++) {
                    if (!visited[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        u = i; v = j;
                    }
                }
            }
        }

        if (u != -1 && v != -1) {
            visited[v] = 1;
            mst[u][v] = mst[v][u] = min;
            total += min;
            edges++;
        }
    }

    printf("\nMST Adjacency Matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++)
            printf("%4d", mst[i][j]);
        printf("\n");
    }

    printf("\nMinimum Cost of Broadcast Tree = %d\n", total);
    return 0;
}


