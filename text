1.Character Stuffing:

#include <stdio.h>
#include <string.h>
int main() {
    char data[50], stuffed[100];
    int i, j = 0;

    printf("Enter data: ");
    scanf("%s", data);

    // Start FLAG
    stuffed[j++] = 'F';

    for (i = 0; i < strlen(data); i++) {
        if (data[i] == 'F' || data[i] == 'E') {  
            stuffed[j++] = 'E';   // Stuff ESC before FLAG/ESC
        }
        stuffed[j++] = data[i];
    }

    // End FLAG
    stuffed[j++] = 'F';
    stuffed[j] = '\0';

    printf("\nAfter Stuffing : %s\n", stuffed);

    return 0;
}

2.Bit Stuffing:
#include <stdio.h>
#include <string.h>

int main() {
    char data[100], stuffed[200];
    int i, j = 0, count = 0;

    printf("Enter bit stream (0s and 1s): ");
    scanf("%s", data);

    for (i = 0; i < strlen(data); i++) {
        if (data[i] == '1') {
            count++;
        } else {
            count = 0;
        }
        stuffed[j++] = data[i];

        if (count == 5) {      // After 5 consecutive 1s
            stuffed[j++] = '0'; // Stuff a 0
            count = 0;
        }
    }
    stuffed[j] = '\0';

    printf("\nAfter Bit Stuffing: %s\n", stuffed);

    return 0;
}

