13. Develop a leave management system for an organization where users can apply different types of
leaves such as casual leave and medical leave. They also can view the available number of days
using react application.

App.js

import React, { useState } from "react";

function App() {
  const [cl, setCl] = useState(10);
  const [ml, setMl] = useState(8);
  const [days, setDays] = useState("");
  const [msg, setMsg] = useState("");

  const apply = (type) => {
    if (days <= 0) {
      setMsg("Enter valid days");
      return;
    }

    if (type === "CL") {
      if (days > cl) setMsg("No Casual Leaves Left");
      else {
        setCl(cl - days);
        setMsg("CL Applied");
      }
    } else {
      if (days > ml) setMsg("No Medical Leaves Left");
      else {
        setMl(ml - days);
        setMsg("ML Applied");
      }
    }

    setDays("");
  };

  return (
    <div style={{ textAlign: "center", marginTop: 50 }}>
      <h2>Leave Management</h2>

      <input
        type="number"
        value={days}
        onChange={(e) => setDays(Number(e.target.value))}
      /><br /><br />

      <p>Casual Leave: {cl}</p>
      <button onClick={() => apply("CL")}>Apply CL</button>

      <p>Medical Leave: {ml}</p>
      <button onClick={() => apply("ML")}>Apply ML</button>

      <p>{msg}</p>
    </div>
  );
}

export default App;

